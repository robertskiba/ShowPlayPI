# Settings for build/build.sh

# Official base image: Raspberry Pi OS Lite (64-bit), trixie, 2026-06-18
BASE_IMAGE_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-06-19/2026-06-18-raspios-trixie-arm64-lite.img.xz
BASE_IMAGE_SHA256=acff736ca7945e3b305f07cda4abdb870910e12634991da69783611756e381b3

# Additional space in the root file system for Chromium, X11, Companion, Ontime etc. while building (MB).
EXTRA_SIZE_MB=4608
# At the end the Linux partition shrinks to its content plus this headroom (MB), so the image also fits on 8 GB
# cards. On the first start it grows again (12 GiB, on 8 GB cards about 5.9 GiB) and the media partition gets
# the rest (showplaypi-media).
ROOT_HEADROOM_MB=768

# Companion mode: official ARM64 build of Bitfocus Companion (brings its own Node), unpacked to /opt/companion.
# Pinned with checksum; the device updates it itself later (within the major version, see ROADMAP).
COMPANION_URL=https://cf-pub.bitfocus.io/companion/companion/companion-linux-arm64-5.0.7-9763-stable-cec2f88e6f.tar.gz
COMPANION_SHA256=d042c6ae40a7ff210c6c7ebc5195e04bbdfbfa91040e91ff7364a1173e99e5e5
# Offline module bundle of the same Companion version (all modules of the store, about 150 MB): lets Companion
# add connections without internet; installed on the first start of the mode (showplaypi-companion-modules)
COMPANION_BUNDLE_URL=https://cf-pub.bitfocus.io/companion/companion-offline-module-bundle/companion-offline-module-bundle-5.0.7-9763-stable-cec2f88e6f.tar.gz
COMPANION_BUNDLE_SHA256=e353387fe9b8ef943ac35e373dbd1ae6a0e742d816c6b714f2aef06c9cfc6f6b

# Ontime mode: container image, bundled as an archive and loaded into Podman on the first start of the mode.
# An exact version is fetched and stored under the tag the device uses (showplaypi-ontime.service).
ONTIME_IMAGE=docker.io/getontime/ontime:v4.14.0
ONTIME_IMAGE_TAG=docker.io/getontime/ontime:v4
ONTIME_ARCHIVE=ontime-v4.tar

# yes = upgrade all packages to the latest version, no = keep the state of the base image
FULL_UPGRADE=yes

# Credentials – intentionally simple, see CLAUDE.md
ADMIN_PASSWORD=admin
VNC_PASSWORD=admin

TIMEZONE=Europe/Berlin
