[Unit]
Description=ShowPlayPI Companion (Bitfocus Companion in the background)
After=showplaypi-mode.service showplaypi-media.service network.target
# The time zone from the configuration is set first (showplaypi-system-config)
After=showplaypi-system-config.service
# Only in Companion mode ([SYSTEM] MODE=companion, see showplaypi-mode); the browser shows the emulators
ConditionPathExists=/run/showplaypi/mode-companion
ConditionPathIsDirectory=/opt/companion

[Service]
Type=simple
User=admin
Group=admin
# USB surfaces such as the Stream Deck: Companion generates udev rules for its surface modules, and
# showplaypi-companion-udev installs them (group plugdev); 50-showplaypi-companion.rules covers the first start
SupplementaryGroups=plugdev dialout input
Environment="COMPANION_SYNC_UDEV_RULES_COMMAND=sudo -n /usr/local/sbin/showplaypi-companion-udev"
Environment=COMPANION_IN_SYSTEMD=1
# Layout as on CompanionPi and /etc/companion/config.yaml (companion-config), as root
ExecStartPre=+/usr/local/sbin/showplaypi-companion-setup
# Rules of an earlier start, before Companion itself runs
ExecStartPre=+/usr/local/sbin/showplaypi-companion-udev
# Companion's backups go to COMPANION/BACKUP on the SHOWPLAYPI drive (a link, Companion's settings unchanged)
ExecStartPre=/usr/local/bin/showplaypi-companion-backups
# HTTPS (modules, updates) needs the right time: wait up to 20 s for the clock while a network is up
ExecStartPre=-/usr/local/sbin/showplaypi-clock --wait 20
# Offline module bundle (all modules of the store): installed on the first start of the mode, about a minute
ExecStartPre=-/usr/local/bin/showplaypi-companion-modules
# Launch options from /etc/companion/config.yaml (sudo companion-config; web interface on port 8000 by default),
# configuration on the Linux partition
ExecStart=/usr/local/bin/showplaypi-companion-launch
Restart=always
RestartSec=3
# Companion saves its database on shutdown (stopped like on CompanionPi)
KillSignal=SIGINT
TimeoutStopSec=20
# The first start installs the offline module bundle
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
