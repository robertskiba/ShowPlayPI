[Unit]
Description=ShowPlayPI idle timeout (return to the start page)
After=showplaypi-kiosk.service

# Only in modes with the kiosk browser: browser, ontime, companion (see showplaypi-mode)
After=showplaypi-mode.service
ConditionPathExists=/run/showplaypi/mode-browser-ui

[Service]
Type=simple
User=admin
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/admin/.Xauthority
ExecStart=/usr/local/bin/showplaypi-idle
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
