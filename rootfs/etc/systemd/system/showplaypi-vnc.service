[Unit]
Description=ShowPlayPI VNC
Wants=network-online.target
Requires=showplaypi-kiosk.service
After=network-online.target showplaypi-kiosk.service

# X session: in every mode with a picture – browser, video, ontime, companion (see showplaypi-mode)
After=showplaypi-mode.service
ConditionPathExists=/run/showplaypi/mode-x11

[Service]
Type=simple
User=admin
ExecStart=/usr/local/bin/showplaypi-vnc
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
