[Unit]
Description=ShowPlayPI Website Watchdog
# Starts together with the kiosk, without waiting for the network: it loads the page as soon as it is reachable
# and refreshes the setup page when the network comes up

# Only in modes with the kiosk browser: browser, ontime, companion (see showplaypi-mode)
After=showplaypi-mode.service
ConditionPathExists=/run/showplaypi/mode-browser-ui

[Service]
Type=simple
User=admin
ExecStart=/usr/local/bin/showplaypi-web-watchdog
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
