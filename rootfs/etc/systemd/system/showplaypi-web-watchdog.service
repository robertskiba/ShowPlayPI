[Unit]
Description=ShowPlayPI Website Watchdog
After=network-online.target
Wants=network-online.target

# Only in modes with the kiosk browser: browser, ontime, companion (see showplaypi-mode)
After=showplaypi-mode.service
ConditionPathExists=/run/showplaypi/mode-browser-ui

[Service]
Type=simple
User=admin
ExecStart=/usr/local/bin/showplaypi-web-watchdog
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
