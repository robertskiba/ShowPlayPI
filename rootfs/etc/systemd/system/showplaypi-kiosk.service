[Unit]
Description=ShowPlayPI Kiosk
# Does not wait for the network: the picture appears right away in every mode, also without a network cable
# or DHCP server. A web page that is not reachable yet is loaded by showplaypi-web-watchdog as soon as it is.
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

# X session: in every mode with a picture – browser, video, ontime, companion (see showplaypi-mode)
After=showplaypi-mode.service
ConditionPathExists=/run/showplaypi/mode-x11

[Service]
Type=simple
User=admin
Group=admin
PAMName=login
WorkingDirectory=/home/admin
Environment=HOME=/home/admin
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
ExecStart=/usr/bin/startx -- vt1 -keeptty
# startx runs X and the browser in their own login session, so stopping the service only reached startx:
# X and Chromium kept running for 90 seconds (and a Pi 5 could hang). xinit shuts both down cleanly.
ExecStop=/usr/bin/pkill --signal TERM --exact xinit
TimeoutStopSec=15
# startx reports 1 when xinit was stopped this way
SuccessExitStatus=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
