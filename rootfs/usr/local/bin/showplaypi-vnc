#!/bin/bash

CONFIG="/etc/showplaypi/showplaypi.ini"
DEFAULT_PORT=5900
PASSWORD_FILE="/home/admin/.vnc/passwd"
XAUTHORITY_FILE="/home/admin/.Xauthority"

ini_get() {
    local section="$1"
    local key="$2"

    awk -v wanted_section="$section" -v wanted_key="$key" '
        {
            sub(/\r$/, "")
        }

        /^[[:space:]]*[#;]/ {
            next
        }

        /^[[:space:]]*\[/ {
            line = $0
            gsub(/^[[:space:]]*\[/, "", line)
            gsub(/\][[:space:]]*$/, "", line)
            section = line
            next
        }

        section == wanted_section {
            position = index($0, "=")

            if (position == 0) {
                next
            }

            key = substr($0, 1, position - 1)
            value = substr($0, position + 1)

            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)

            if (key == wanted_key) {
                print value
                exit
            }
        }
    ' "$CONFIG"
}

ENABLED="$(ini_get VNC ENABLED)"
PORT="$(ini_get VNC PORT)"

if [ -z "$ENABLED" ]; then
    ENABLED="yes"
fi

if ! [[ "$PORT" =~ ^[0-9]+$ ]] ||
   [ "$PORT" -lt 1024 ] ||
   [ "$PORT" -gt 65535 ]; then

    logger -t showplaypi-vnc \
        "Invalid VNC port. Falling back to $DEFAULT_PORT."

    PORT="$DEFAULT_PORT"
fi

case "${ENABLED,,}" in
    no|false|0|off)
        logger -t showplaypi-vnc "VNC access is disabled."
        exec sleep infinity
        ;;

    yes|true|1|on)
        ;;

    *)
        logger -t showplaypi-vnc \
            "Invalid ENABLED value. VNC access remains enabled."
        ;;
esac

if [ ! -f "$PASSWORD_FILE" ]; then
    logger -t showplaypi-vnc \
        "VNC password file is missing: $PASSWORD_FILE"
    exit 1
fi

exec /usr/bin/x11vnc \
    -display :0 \
    -auth "$XAUTHORITY_FILE" \
    -forever \
    -shared \
    -rfbauth "$PASSWORD_FILE" \
    -rfbport "$PORT" \
    -noxdamage \
    -repeat
