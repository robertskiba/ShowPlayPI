#!/bin/bash
# The page the kiosk browser shows.
#
#   showplaypi-current-url          the page of the current session: set via OSC, otherwise the start page
#   showplaypi-current-url --home   the start page from showplaypi.ini (ignores a page set via OSC)
#
# Start page: [BROWSER] URL if set. Otherwise it depends on the operating mode:
#   companion  Companion's emulator chooser (other views via OSC: /showplaypi/companion/…)
#   ontime     the Ontime view from [ONTIME] VIEW (e.g. timer)
#   others     the local setup page

CONFIG="/etc/showplaypi/showplaypi.ini"
RUNTIME_URL_FILE="/run/showplaypi/runtime-url"
DEFAULT_URL="file:///home/admin/kiosk/setup.html"
# Companion's port can be changed with `sudo companion-config`
COMPANION_URL="http://127.0.0.1:$(/usr/local/bin/showplaypi-companion-port)"
ONTIME_URL="http://127.0.0.1:4001"

validate_url() {
    case "$1" in
        http://*|https://*|file://*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

ini_get() {
    local section="$1"
    local key="$2"

    awk -v wanted_section="$section" -v wanted_key="$key" '
        {
            sub(/\r$/, "")
        }

        /^[[:space:]]*[#;]/ {
            next
        }

        /^[[:space:]]*\[/ {
            line = $0
            gsub(/^[[:space:]]*\[/, "", line)
            gsub(/\][[:space:]]*$/, "", line)
            section = line
            next
        }

        section == wanted_section {
            position = index($0, "=")

            if (position == 0) {
                next
            }

            key = substr($0, 1, position - 1)
            value = substr($0, position + 1)

            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)

            if (key == wanted_key) {
                print value
                exit
            }
        }
    ' "$CONFIG" 2>/dev/null
}

# Start page of Companion and Ontime mode when no own URL is configured
mode_url() {
    local view

    case "$(/usr/local/bin/showplaypi-mode)" in
        companion)
            printf '%s/emulators\n' "$COMPANION_URL"
            ;;
        ontime)
            view="$(ini_get ONTIME VIEW)"
            # A view name like "timer", optionally with the options of the view's settings:
            # "backstage?stopCycle=true&extra-info=0-Custom+data". Anything unusual falls back to the timer.
            if [[ $view =~ ^([A-Za-z0-9_-]+)\?([^[:space:]]+)$ ]]; then
                printf '%s/%s/?%s\n' "$ONTIME_URL" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
            else
                [[ $view =~ ^[A-Za-z0-9_-]+$ ]] || view="timer"
                printf '%s/%s\n' "$ONTIME_URL" "$view"
            fi
            ;;
        *)
            printf '%s\n' "$DEFAULT_URL"
            ;;
    esac
}

if [ "${1:-}" != "--home" ] && [ -s "$RUNTIME_URL_FILE" ]; then
    RUNTIME_URL="$(head -n 1 "$RUNTIME_URL_FILE" | tr -d '\r\n')"

    if validate_url "$RUNTIME_URL"; then
        printf '%s\n' "$RUNTIME_URL"
        exit 0
    fi
fi

CONFIG_URL="$(ini_get BROWSER URL)"
# Older configurators always wrote the setup page: that means "no own page" as well
[ "$CONFIG_URL" = "$DEFAULT_URL" ] && CONFIG_URL=""

# ASCII form of the URL (umlauts in host or path, spaces, Windows character set from the configurator)
if [ -n "$CONFIG_URL" ] &&
   NORMALIZED_URL="$(/usr/local/bin/showplaypi-normalize-url "$CONFIG_URL" 2>/dev/null)"; then
    printf '%s\n' "$NORMALIZED_URL"
else
    mode_url
fi
