#!/usr/bin/python3

import json
import logging
import os
import socket
import sqlite3
import struct
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/usr/local/lib/showplaypi")
from showplaypi_url import decode_text, normalize_url  # noqa: E402

OSC_HOST = "0.0.0.0"
OSC_PORT = 23878

DISPLAY = ":0"
XAUTHORITY = "/home/admin/.Xauthority"

RUNTIME_DIRECTORY = Path("/run/showplaypi")
RUNTIME_URL_FILE = RUNTIME_DIRECTORY / "runtime-url"
# Session override for [BROWSER] IDLE_TIMEOUT, read by showplaypi-idle
IDLE_TIMEOUT_FILE = RUNTIME_DIRECTORY / "idle-timeout"
# Time of our own simulated key presses, so showplaypi-idle does not mistake them for user input
SYNTHETIC_INPUT_FILE = RUNTIME_DIRECTORY / "synthetic-input"

CONFIG_FILE = Path("/etc/showplaypi/showplaypi.ini")
DEFAULT_URL = "file:///home/admin/kiosk/setup.html"

# Video mode: commands go to showplaypi-video, which writes its state to a JSON file
VIDEO_SOCKET = RUNTIME_DIRECTORY / "video.sock"
VIDEO_STATUS_FILE = RUNTIME_DIRECTORY / "video-status.json"
# Audio player ([AUDIO] ENABLED=yes, any mode): commands go to showplaypi-audio
AUDIO_SOCKET = RUNTIME_DIRECTORY / "audio.sock"
AUDIO_STATUS_FILE = RUNTIME_DIRECTORY / "audio-status.json"
AUDIO_PLAYER_FLAG = RUNTIME_DIRECTORY / "audio-player"
BROWSER_MODES = ("browser", "ontime", "companion")
# Companion mode: Companion runs on the device (showplaypi-companion.service)
COMPANION_URL = "http://127.0.0.1:8000"
COMPANION_CONFIG = Path("/home/admin/companion")
# Ontime mode: the Ontime server runs on the device (showplaypi-ontime.service)
ONTIME_URL = "http://127.0.0.1:4001"

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s showplaypi-osc: %(message)s",
)

log = logging.getLogger("showplaypi-osc")



def ini_value(section_name, key_name, default_value):
    current_section = ""

    try:
        lines = CONFIG_FILE.read_text(
            encoding="utf-8",
            errors="replace",
        ).splitlines()
    except OSError as error:
        log.error("Could not read showplaypi.ini: %s", error)
        return default_value

    for raw_line in lines:
        line = raw_line.strip()

        if not line or line.startswith(("#", ";")):
            continue

        if line.startswith("[") and line.endswith("]"):
            current_section = line[1:-1].strip()
            continue

        if current_section == section_name and "=" in line:
            key, value = line.split("=", 1)

            if key.strip() == key_name:
                return value.strip()

    return default_value


def ini_boolean(section_name, key_name, default_value):
    default_text = "yes" if default_value else "no"
    value = ini_value(section_name, key_name, default_text)
    return value.strip().lower() in ("yes", "true", "1", "on")

def read_osc_string(data, offset):
    end = data.find(b"\0", offset)

    if end < 0:
        raise ValueError("OSC string is not terminated")

    # UTF-8 as required by OSC 1.0; older senders may use Latin-1 (e.g. URLs with umlauts)
    value = decode_text(data[offset:end])
    offset = (end + 4) & ~3
    return value, offset


def parse_osc_message(data):
    address, offset = read_osc_string(data, 0)
    type_tags, offset = read_osc_string(data, offset)

    if not type_tags.startswith(","):
        raise ValueError("OSC type tag is missing")

    arguments = []

    for type_tag in type_tags[1:]:
        if type_tag == "s":
            value, offset = read_osc_string(data, offset)
            arguments.append(value)
        elif type_tag == "i":
            arguments.append(struct.unpack_from(">i", data, offset)[0])
            offset += 4
        elif type_tag == "f":
            arguments.append(struct.unpack_from(">f", data, offset)[0])
            offset += 4
        elif type_tag == "T":
            arguments.append(True)
        elif type_tag == "F":
            arguments.append(False)
        else:
            raise ValueError(f"Unsupported OSC type tag: {type_tag}")

    return address, arguments


def valid_url(value):
    return value.startswith(("http://", "https://", "file://"))


def configured_url():
    # The start page from showplaypi.ini – in Companion and Ontime mode their view if no own URL is set
    result = subprocess.run(
        ["/usr/local/bin/showplaypi-current-url", "--home"],
        text=True,
        capture_output=True,
        check=False,
    )
    url = result.stdout.strip()

    return url if valid_url(url) else DEFAULT_URL


def chromium_window():
    environment = os.environ.copy()
    environment["DISPLAY"] = DISPLAY
    environment["XAUTHORITY"] = XAUTHORITY

    result = subprocess.run(
        [
            "xdotool",
            "search",
            "--onlyvisible",
            "--class",
            "chromium",
        ],
        env=environment,
        text=True,
        capture_output=True,
        check=False,
    )

    for line in result.stdout.splitlines():
        if line.strip().isdigit():
            return line.strip()

    return None


def xdotool(*arguments):
    window_id = chromium_window()

    if window_id is None:
        raise RuntimeError("No visible Chromium window found")

    environment = os.environ.copy()
    environment["DISPLAY"] = DISPLAY
    environment["XAUTHORITY"] = XAUTHORITY

    subprocess.run(
        ["xdotool", *arguments],
        env=environment,
        check=True,
    )

    return window_id


def restart_chromium():
    result = subprocess.run(
        ["pkill", "-TERM", "-x", "chromium"],
        check=False,
    )

    if result.returncode not in (0, 1):
        raise RuntimeError(
            f"Could not restart Chromium: exit code {result.returncode}"
        )

    log.info("Chromium restart triggered")


def open_url(url):
    # ASCII form (IDNA host, percent-encoded path) so Chromium, watchdog and idle service agree
    url = normalize_url(url)

    RUNTIME_DIRECTORY.mkdir(parents=True, exist_ok=True)

    temporary_file = RUNTIME_URL_FILE.with_suffix(".new")
    temporary_file.write_text(url + "\n", encoding="utf-8")
    temporary_file.replace(RUNTIME_URL_FILE)

    restart_chromium()
    log.info("Runtime URL selected: %s", url)


def set_idle_timeout(arguments):
    # Session-only: overrides [BROWSER] IDLE_TIMEOUT until the next reboot.
    # All times in OSC are milliseconds; the idle service works in whole seconds.
    if len(arguments) != 1 or isinstance(arguments[0], bool):
        raise ValueError("/showplaypi/browser/idle requires one number argument (milliseconds)")

    try:
        milliseconds = int(float(arguments[0]))
    except (TypeError, ValueError):
        raise ValueError("/showplaypi/browser/idle requires one number argument (milliseconds)")

    if milliseconds < 0 or milliseconds > 86_400_000:
        raise ValueError("/showplaypi/browser/idle accepts 0 (off) to 86400000 milliseconds")

    # Rounded up, so that a short time never turns the idle timeout off
    seconds = (milliseconds + 999) // 1000

    RUNTIME_DIRECTORY.mkdir(parents=True, exist_ok=True)
    temporary_file = IDLE_TIMEOUT_FILE.with_suffix(".new")
    temporary_file.write_text(f"{seconds}\n", encoding="utf-8")
    temporary_file.replace(IDLE_TIMEOUT_FILE)

    if seconds == 0:
        log.info("Idle timeout disabled for this session")
    else:
        log.info("Idle timeout set to %s seconds for this session", seconds)


def mark_synthetic_input():
    try:
        SYNTHETIC_INPUT_FILE.write_text(f"{time.time()}\n", encoding="utf-8")
    except OSError as error:
        log.warning("Could not record synthetic input: %s", error)


def refresh_browser():
    window_id = chromium_window()

    if window_id is None:
        raise RuntimeError("No visible Chromium window found")

    environment = os.environ.copy()
    environment["DISPLAY"] = DISPLAY
    environment["XAUTHORITY"] = XAUTHORITY

    mark_synthetic_input()
    subprocess.run(
        [
            "xdotool",
            "key",
            "--window",
            window_id,
            "--clearmodifiers",
            "ctrl+r",
        ],
        env=environment,
        check=True,
    )

    log.info("Browser refresh triggered")


def return_home():
    try:
        RUNTIME_URL_FILE.unlink()
    except FileNotFoundError:
        pass

    home_url = configured_url()
    open_url(home_url)

    try:
        RUNTIME_URL_FILE.unlink()
    except FileNotFoundError:
        pass

    log.info("Configured home URL opened: %s", home_url)



def connected_output():
    environment = os.environ.copy()
    environment["DISPLAY"] = DISPLAY
    environment["XAUTHORITY"] = XAUTHORITY

    result = subprocess.run(
        ["xrandr", "--query"],
        env=environment,
        text=True,
        capture_output=True,
        check=False,
    )

    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or "Could not query display outputs"
        )

    for line in result.stdout.splitlines():
        if " connected" in line:
            return line.split()[0]

    raise RuntimeError("No connected display output found")


def set_blackout(enabled):
    output = connected_output()

    environment = os.environ.copy()
    environment["DISPLAY"] = DISPLAY
    environment["XAUTHORITY"] = XAUTHORITY

    brightness = "0" if enabled else "1"

    result = subprocess.run(
        [
            "xrandr",
            "--output",
            output,
            "--brightness",
            brightness,
        ],
        env=environment,
        text=True,
        capture_output=True,
        check=False,
    )

    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or "Could not change display brightness"
        )

    state = "enabled" if enabled else "disabled"
    log.info("Display blackout %s on %s", state, output)


def blackout_argument(arguments):
    if len(arguments) != 1:
        raise ValueError("/showplaypi/blackout requires one argument")

    value = arguments[0]

    if isinstance(value, bool):
        return value

    if isinstance(value, (int, float)):
        if value == 1:
            return True

        if value == 0:
            return False

    if isinstance(value, str):
        normalized = value.strip().lower()

        if normalized in ("1", "on", "yes", "true"):
            return True

        if normalized in ("0", "off", "no", "false"):
            return False

    raise ValueError(
        "/showplaypi/blackout accepts only 1/0, true/false or on/off"
    )

def active_mode():
    # The mode only changes with a restart, so it is read once
    result = subprocess.run(
        ["/usr/local/bin/showplaypi-mode"],
        text=True,
        capture_output=True,
        check=False,
    )
    return result.stdout.strip() or "browser"


def send_to_video(command, arguments):
    message = json.dumps({"command": command, "args": arguments}).encode("utf-8")

    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as video_socket:
        try:
            video_socket.sendto(message, str(VIDEO_SOCKET))
        except OSError as error:
            raise RuntimeError(f"Video player is not running: {error}")


def osc_string(text):
    data = text.encode("utf-8") + b"\0"
    return data + b"\0" * (-len(data) % 4)


def reply(osc_socket, destination, address, text):
    message = osc_string(address) + osc_string(",s") + osc_string(text)
    osc_socket.sendto(message, destination)


def send_to_audio(command, arguments):
    message = json.dumps({"command": command, "args": arguments}).encode("utf-8")

    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as audio_socket:
        try:
            audio_socket.sendto(message, str(AUDIO_SOCKET))
        except OSError as error:
            raise RuntimeError(f"Audio player is not running: {error}")


def reply_audio_state(osc_socket, destination, command):
    # The player writes its state right after the command; give it a moment
    time.sleep(0.2)

    try:
        status = json.loads(AUDIO_STATUS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise RuntimeError(f"No audio player state available: {error}")

    if command == "list":
        reply(osc_socket, destination, "/showplaypi/audio/files",
              json.dumps({"jingles": status.get("jingles", []), "playlists": status.get("playlists", [])}))
    else:
        status.pop("jingles", None)
        status.pop("playlists", None)
        reply(osc_socket, destination, "/showplaypi/audio/status", json.dumps(status))


def reply_video_state(osc_socket, destination, command):
    # The player writes its state right after the command; give it a moment
    time.sleep(0.2)

    try:
        status = json.loads(VIDEO_STATUS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise RuntimeError(f"No video player state available: {error}")

    if command == "list":
        reply(osc_socket, destination, "/showplaypi/video/files",
              json.dumps({"playlists": status.get("playlists", [])}))
    else:
        status.pop("playlists", None)
        reply(osc_socket, destination, "/showplaypi/video/status", json.dumps(status))


def whole_number(value, name, minimum, maximum):
    try:
        number = int(float(value))
    except (TypeError, ValueError):
        raise ValueError(f"{name} must be a number")

    if isinstance(value, bool) or number < minimum or number > maximum:
        raise ValueError(f"{name} must be between {minimum} and {maximum}")

    return number


def companion_emulators():
    # Emulators as Companion stores them (table "surfaces", IDs "emulator:<id>"), read-only – newest
    # configuration version first (Companion keeps one folder per version, e.g. v5.0)
    databases = sorted(
        COMPANION_CONFIG.glob("v*/db.sqlite"),
        key=lambda path: [int(part) if part.isdigit() else 0 for part in path.parent.name[1:].split(".")],
        reverse=True,
    )

    if not databases:
        return []

    connection = sqlite3.connect(f"file:{databases[0]}?mode=ro", uri=True, timeout=2)

    try:
        rows = connection.execute("SELECT id, value FROM surfaces WHERE id LIKE 'emulator:%'").fetchall()
    finally:
        connection.close()

    emulators = []

    for surface_id, value in rows:
        try:
            surface = json.loads(value)
        except (TypeError, ValueError):
            surface = {}

        grid = surface.get("gridSize") or {}
        emulators.append({
            "id": surface_id.split(":", 1)[1],
            "name": surface.get("name") or surface_id.split(":", 1)[1],
            "columns": grid.get("columns"),
            "rows": grid.get("rows"),
        })

    return sorted(emulators, key=lambda emulator: emulator["name"].casefold())


def companion_command(command, arguments, source, osc_socket):
    # Views of Companion in the kiosk browser; they become the page of the current session.
    # Pressing buttons etc. goes to Companion's own OSC/HTTP interfaces (docs/OSC.md).
    if command == "emulators":
        # The list for a dropdown in the controller: reply to the sender (optional reply port)
        destination = source

        if arguments:
            destination = (source[0], whole_number(arguments[0], "port", 1, 65535))

        reply(osc_socket, destination, "/showplaypi/companion/emulators",
              json.dumps({"emulators": companion_emulators()}))

    elif command == "emulator":
        if not arguments:
            open_url(f"{COMPANION_URL}/emulators")
        else:
            wanted = str(arguments[0]).strip()
            # The ID, or the name as shown in Companion (case-insensitive)
            match = next(
                (emulator["id"] for emulator in companion_emulators()
                 if wanted == emulator["id"] or wanted.casefold() == emulator["name"].casefold()),
                wanted,
            )

            if not match or not all(c.isalnum() or c in "-_" for c in match):
                raise ValueError(f"/showplaypi/companion/emulator: unknown emulator {wanted!r}")

            open_url(f"{COMPANION_URL}/emulator/{match}")

    elif command == "tablet":
        # [pages] [columns] [rows]: e.g. 3 4 2 = page 3 with 4 x 2 buttons
        query = ["noconfigure=1", "nofullscreen=1"]

        if len(arguments) >= 1:
            pages = str(arguments[0]).replace(" ", "")

            if isinstance(arguments[0], float):
                pages = str(int(arguments[0]))

            if not pages or not all(part.isdigit() for part in pages.split(",")):
                raise ValueError("/showplaypi/companion/tablet: pages as a number or a list like \"1,2\"")

            query.append(f"pages={pages}")

        if len(arguments) >= 2:
            columns = whole_number(arguments[1], "columns", 1, 32)
            query += ["min_col=0", f"max_col={columns - 1}"]

        if len(arguments) >= 3:
            rows = whole_number(arguments[2], "rows", 1, 32)
            query += ["min_row=0", f"max_row={rows - 1}"]

        open_url(f"{COMPANION_URL}/tablet?{'&'.join(query)}")

    elif command == "restart":
        subprocess.run(
            ["sudo", "-n", "systemctl", "restart", "showplaypi-companion.service"],
            check=True,
        )
        log.info("Companion restart triggered")

    elif command == "backup":
        log.info("Ignored /showplaypi/companion/backup: not implemented yet")

    else:
        raise ValueError(f"Unknown Companion command: {command}")


def ontime_command(command, arguments):
    # /showplaypi/ontime/view <view> [parameters]: an Ontime view with the options of its settings panel,
    # e.g. "backstage" "stopCycle=true&extra-info=0-Custom+data". The parameters are passed on unchanged,
    # so every setting of Ontime's views can be sent; the view becomes the page of the current session.
    if command != "view":
        raise ValueError(f"Unknown Ontime command: {command}")

    if not arguments or not isinstance(arguments[0], str):
        raise ValueError("/showplaypi/ontime/view requires the view name, e.g. \"timer\"")

    view = arguments[0].strip().strip("/")

    if not view or not all(c.isalnum() or c in "-_" for c in view):
        raise ValueError(f"/showplaypi/ontime/view: invalid view name {view!r}")

    # Parameters as one string ("a=1&b=2") or as several strings ("a=1", "b=2")
    parameters = "&".join(str(argument).strip().lstrip("?") for argument in arguments[1:] if str(argument).strip())

    if parameters:
        open_url(f"{ONTIME_URL}/{view}/?{parameters}")
    else:
        open_url(f"{ONTIME_URL}/{view}")


def handle_message(address, arguments, source, mode, osc_socket):
    log.info("Received %s %s from %s:%s", address, arguments, *source)

    # Commands of an inactive mode are ignored (docs/OSC.md, naming scheme)
    if address.startswith("/showplaypi/browser/") and mode not in BROWSER_MODES:
        log.info("Ignored %s: no browser in %s mode", address, mode)
        return

    if address.startswith("/showplaypi/video/"):
        if mode != "video":
            log.info("Ignored %s: not in video mode (%s mode)", address, mode)
            return

        command = address[len("/showplaypi/video/"):]
        send_to_video(command, arguments)

        if command in ("list", "status"):
            reply_video_state(osc_socket, source, command)

        return

    if address.startswith("/showplaypi/companion/"):
        if mode != "companion":
            log.info("Ignored %s: not in Companion mode (%s mode)", address, mode)
            return

        companion_command(address[len("/showplaypi/companion/"):], arguments, source, osc_socket)
        return

    if address.startswith("/showplaypi/ontime/"):
        if mode != "ontime":
            log.info("Ignored %s: not in Ontime mode (%s mode)", address, mode)
            return

        ontime_command(address[len("/showplaypi/ontime/"):], arguments)
        return

    if address.startswith("/showplaypi/audio/"):
        # The audio player is an optional extra in any mode ([AUDIO] ENABLED=yes)
        if not AUDIO_PLAYER_FLAG.exists():
            log.info("Ignored %s: the audio player is not enabled", address)
            return

        command = address[len("/showplaypi/audio/"):]
        send_to_audio(command, arguments)

        if command in ("list", "status"):
            reply_audio_state(osc_socket, source, command)

        return

    if address == "/showplaypi/blackout" and mode == "video":
        # The player fades its own picture (optional second argument: fade in milliseconds)
        send_to_video("blackout", [blackout_argument(arguments[:1]), *arguments[1:2]])
        return

    if address == "/showplaypi/browser/url":
        if len(arguments) != 1 or not isinstance(arguments[0], str):
            raise ValueError("/showplaypi/browser/url requires one string argument")

        open_url(arguments[0])

    elif address == "/showplaypi/browser/idle":
        set_idle_timeout(arguments)

    elif address == "/showplaypi/browser/refresh":
        refresh_browser()

    elif address == "/showplaypi/browser/home":
        return_home()

    elif address == "/showplaypi/browser/restart":
        if arguments:
            raise ValueError("/showplaypi/browser/restart does not accept arguments")

        restart_chromium()

    elif address == "/showplaypi/blackout":
        set_blackout(blackout_argument(arguments))

    else:
        log.warning("Unknown OSC address: %s", address)


def main():
    if not ini_boolean("OSC", "ENABLED", True):
        log.info("OSC remote control is disabled in showplaypi.ini")
        return

    RUNTIME_DIRECTORY.mkdir(parents=True, exist_ok=True)

    osc_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    osc_socket.bind((OSC_HOST, OSC_PORT))

    mode = active_mode()
    log.info("Listening for OSC messages on UDP port %s (%s mode)", OSC_PORT, mode)

    while True:
        data, source = osc_socket.recvfrom(65535)

        try:
            address, arguments = parse_osc_message(data)
            handle_message(address, arguments, source, mode, osc_socket)
        except Exception as error:
            log.error("OSC message rejected: %s", error)


if __name__ == "__main__":
    main()
