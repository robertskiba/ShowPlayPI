#!/bin/sh
# Opens showplaypi.ini of the SHOWPLAYPI drive in an editor (the copy users also see over USB).

FILE="/media/showplaypi/showplaypi.ini"
[ -f "$FILE" ] || FILE="/etc/showplaypi/showplaypi.ini"

sudo mcedit "$FILE"

echo
echo "ShowPlayPI configuration saved."
echo "Restart to apply changes: sudo reboot"
echo
