#!/bin/bash
# companion-reset – wipes Companion's configuration (connections, buttons, pages, settings), the same way as on
# Bitfocus' CompanionPi (https://github.com/bitfocus/companion-pi, MIT License). Backups in COMPANION/BACKUP on
# the drive SHOWPLAYPI are kept; the offline modules are installed again at the next start (about a minute).

set -e

if [[ $(id -u) -ne 0 ]]; then
    echo "Must be run as root. Try sudo companion-reset"
    exit 1
fi

function ask_yes_or_no() {
    read -r -p "$1 ([y]es or [N]o): "
    case $(echo "$REPLY" | tr '[:upper:]' '[:lower:]') in
        y|yes) echo "yes" ;;
        *)     echo "no" ;;
    esac
}

echo "Are you sure you want to wipe the companion configuration?"
if [[ "no" == $(ask_yes_or_no "") ]]; then
    echo "Abort."
    exit 0
fi

SERVICE=showplaypi-companion.service
was_active=no
systemctl is-active --quiet "$SERVICE" && was_active=yes

systemctl stop "$SERVICE"

# The link to COMPANION/BACKUP is removed, not the backups behind it
rm -rf /home/admin/companion

if [ "$was_active" = yes ]; then
    systemctl start --no-block "$SERVICE"
    echo "Companion starts with an empty configuration."
else
    echo "The configuration is wiped; Companion starts empty in the Companion mode."
fi
