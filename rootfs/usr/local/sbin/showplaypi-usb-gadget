#!/bin/sh
# USB device mode over USB-C: ShowPlayPI appears to a connected computer as a removable drive.
# The drive starts without a medium; showplaypi-usb-drive inserts the media partition when a computer
# connects and takes it back when the computer is done.
set -eu

GADGET_DIR="/sys/kernel/config/usb_gadget/showplaypi"


start_gadget()
{
    if [ -d "$GADGET_DIR" ] &&
       [ -s "$GADGET_DIR/UDC" ]; then
        echo "ShowPlayPI USB gadget is already active."
        exit 0
    fi

    modprobe libcomposite
    modprobe usb_f_mass_storage

    mkdir -p "$GADGET_DIR"
    cd "$GADGET_DIR"

    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    echo 0x0200 > bcdUSB
    echo 0x0100 > bcdDevice

    mkdir -p strings/0x409
    echo "ShowPlayPI" > strings/0x409/manufacturer
    echo "ShowPlayPI Configuration Drive" > strings/0x409/product
    echo "SHOWPLAYPI-CONFIG" > strings/0x409/serialnumber

    mkdir -p configs/c.1/strings/0x409
    echo "ShowPlayPI Configuration" \
        > configs/c.1/strings/0x409/configuration
    echo 250 > configs/c.1/MaxPower

    mkdir -p functions/mass_storage.usb0
    echo 1 > functions/mass_storage.usb0/stall
    # Removable: the computer can eject the drive, and the medium can be inserted later
    echo 1 > functions/mass_storage.usb0/lun.0/removable
    echo 0 > functions/mass_storage.usb0/lun.0/ro
    echo 0 > functions/mass_storage.usb0/lun.0/cdrom
    # Honour "write through" requests of the computer (FUA)
    echo 0 > functions/mass_storage.usb0/lun.0/nofua

    if [ ! -L configs/c.1/mass_storage.usb0 ]; then
        ln -s \
            functions/mass_storage.usb0 \
            configs/c.1/mass_storage.usb0
    fi

    UDC_NAME="$(ls /sys/class/udc | head -n 1)"

    if [ -z "$UDC_NAME" ]; then
        echo "No USB device controller is available."
        exit 1
    fi

    echo "$UDC_NAME" > UDC
    echo "ShowPlayPI USB configuration drive enabled on $UDC_NAME."
}


stop_gadget()
{
    if [ -d "$GADGET_DIR" ]; then
        if [ -e "$GADGET_DIR/UDC" ]; then
            echo "" > "$GADGET_DIR/UDC" || true
        fi

        if [ -e \
            "$GADGET_DIR/functions/mass_storage.usb0/lun.0/file" ]; then
            echo "" \
                > "$GADGET_DIR/functions/mass_storage.usb0/lun.0/file" \
                || true
        fi
    fi

    echo "ShowPlayPI USB configuration drive disabled."
}


case "${1:-}" in
    start)
        start_gadget
        ;;

    stop)
        stop_gadget
        ;;

    *)
        echo "Usage: $0 start|stop"
        exit 1
        ;;
esac
